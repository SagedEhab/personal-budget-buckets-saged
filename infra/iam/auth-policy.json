{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT__:table/PBUsers"
    },
    {
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:__REGION__:__ACCOUNT__:secret:pb/jwt-secret*"
    },
    {
      "Sid": "PrivacyFlowCallsOtherServices",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:__REGION__:__ACCOUNT__:function:pb-buckets-api",
        "arn:aws:lambda:__REGION__:__ACCOUNT__:function:pb-transactions-api",
        "arn:aws:lambda:__REGION__:__ACCOUNT__:function:pb-insights-api"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/aws/lambda/pb-auth-api:*"
    },
    {
      "Sid": "UseDataKeyViaServicesOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:__REGION__:__ACCOUNT__:key/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/pb-data-key"
        },
        "StringEquals": {
          "kms:ViaService": [
            "dynamodb.__REGION__.amazonaws.com",
            "secretsmanager.__REGION__.amazonaws.com"
          ]
        }
      }
    }
  ]
}
